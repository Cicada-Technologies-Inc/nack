#syntax=docker/dockerfile:1.13
#
# Minimal package-only Dockerfile for forks that cross-compile the
# binary on the host (no Go toolchain inside the build context).
#
# One binary per target architecture has to be staged in the build context,
# named jetstream-controller-<arch>. BuildKit sets TARGETARCH once per platform
# it is building, so the same Dockerfile picks the right one.
#
# Build with:
#   for arch in amd64 arm64; do
#     GOOS=linux GOARCH=$arch CGO_ENABLED=0 go build \
#       -tags timetzdata -o ./jetstream-controller-$arch \
#       ./cmd/jetstream-controller
#   done
#   docker buildx build -f cicd/Dockerfile.copy \
#     --platform linux/amd64,linux/arm64 \
#     -t <registry>/<repo>:<tag> --push .

ARG ALPINE_VERSION=3.24.1

FROM alpine:${ALPINE_VERSION}

# Set by BuildKit, once per platform being built.
ARG TARGETARCH
# The per-platform binary. Override only for a one-off build of a single
# architecture from a differently named file.
ARG BIN=jetstream-controller-${TARGETARCH}

RUN apk add --no-cache ca-certificates && \
    addgroup -S nack && adduser -S -G nack nack

COPY ${BIN} /usr/local/bin/jetstream-controller
COPY cicd/assets/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh /usr/local/bin/jetstream-controller && \
    ln -s /usr/local/bin/jetstream-controller /jetstream-controller

USER nack

ENV GO_APP=jetstream-controller

ENTRYPOINT ["/entrypoint.sh"]
